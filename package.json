{
  "name": "open-teleprompter",
  "version": "1.0.0",
  "description": "A free, open-source teleprompter app for Windows and Linux with real-time word tracking, classic auto-scroll, and voice-activated scrolling.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build:web": "node scripts/build-web.js",
    "serve:web": "npm run build:web && npx --yes http-server dist-web -p 8080 -c-1",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "author": "openTeleprompter",
  "license": "MIT",
  "dependencies": {
    "jszip": "^3.10.1",
    "mp4-muxer": "^5.2.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.7.0"
  },
  "build": {
    "appId": "com.openteleprompter.app",
    "productName": "openTeleprompter",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    }
  }
}
